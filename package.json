{
  "name": "localswe",
  "version": "1.0.0",
  "description": "LocalSWE: Autonomous Verification & State-Rollback Harness for Local & Commodity Coding Models",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22",
    "bun": "1.4.0"
  },
  "scripts": {
    "benchmark:validate": "tsx benchmark/scripts/validate.ts",
    "benchmark:check-types": "tsc --noEmit -p tsconfig.benchmark.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "baseline:run:case": "tsx src/cli/run-case.ts",
    "baseline:run": "tsx src/cli/run-baseline.ts",
    "baseline:validate": "tsx src/cli/run-baseline.ts --mock --runs 1",
    "v1:run:case": "tsx src/cli/run-v1-case.ts",
    "v1:run": "tsx src/cli/run-v1.ts",
    "v1:validate": "tsx src/cli/run-v1-case.ts --mock --runs 1",
    "v2:run:case": "tsx src/cli/run-v2-case.ts",
    "v2:run": "tsx src/cli/run-v2.ts",
    "v2:validate": "tsx src/cli/run-v2-case.ts --mock",
    "v3:run:case": "tsx src/cli/run-v3-case.ts",
    "v3:run": "tsx src/cli/run-v3.ts",
    "v3:validate": "tsx src/cli/run-v3-case.ts synth-001 --mock",
    "experiment": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/cli/run-experiment.ts",
    "experiment:v2": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/cli/run-experiment.ts --v2 --reuse-baseline --reuse-v1",
    "experiment:v3": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/cli/run-experiment.ts --v3 --reuse-baseline --reuse-v1 --reuse-v2",
    "experiment:mock": "tsx src/cli/run-experiment.ts --mock",
    "experiment:fast": "tsx src/cli/run-experiment.ts --concurrency 6 --runs 1",
    "experiment:shrink": "tsx scripts/clean-trajectories.ts",
    "evaluate": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/cli/evaluate.ts",
    "evaluate:experiment": "node --max-old-space-size=8192 ./node_modules/tsx/dist/cli.mjs src/cli/evaluate.ts --experiment",
    "evaluator:test": "vitest run src/evaluator/tests"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.4.0",
    "@types/uuid": "^11.0.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "copy-anything": "^4.1.0",
    "es-define-property": "^1.0.1",
    "eventemitter3": "^5.0.4",
    "mri": "^1.2.0",
    "p-timeout": "^7.0.1",
    "side-channel": "^1.1.1",
    "uuid": "^14.0.2"
  }
}
