# Frontier Verifier — Baseline v0 environment
# Copy to .env and fill PROVIDER_API_KEY. Model id must match pi catalog exactly.
# See pi catalog: node_modules/@earendil-works/pi-ai/dist/providers/data/opencode-go.json
# Correct id is opencode-go/muse-spark-1.2-contributor (not meta/muse-spark-1.2)

PROVIDER=opencode-go
PROVIDER_API_KEY=your-opencode-token-here
AGENT_MODEL=opencode-go/muse-spark-1.2-contributor
AGENT_RUNTIME=pi
AGENT_THINKING_LEVEL=medium
AGENT_TIMEOUT_MS=600000
COMMAND_TIMEOUT_SEC=30

# For local mock testing without LLM (no API key needed):
# BASELINE_MOCK=1
# AGENT_MODEL=mock
