diff --git a/src/CAC.ts b/src/CAC.ts
index 7a3df11..4bf3879 100644
--- a/src/CAC.ts
+++ b/src/CAC.ts
@@ -311,6 +311,19 @@ class CAC extends EventEmitter {
       }
     }
 
+    // Sync alias names with the primary name value
+    // This ensures that when --base-url is parsed, -b also gets the same value
+    for (const cliOption of cliOptions) {
+      if (cliOption.names.length > 1) {
+        const value = options[cliOption.name]
+        if (value !== undefined) {
+          for (const name of cliOption.names) {
+            options[name] = value
+          }
+        }
+      }
+    }
+
     return {
       args,
       options,
diff --git a/tests/cac.test.ts b/tests/cac.test.ts
index 5ae436f..f881530 100644
--- a/tests/cac.test.ts
+++ b/tests/cac.test.ts
@@ -34,4 +34,32 @@ describe("cac regression", () => {
     expect(options.baseUrl).toBe("https://github.com");
     expect(options.b).toBe("https://github.com");
   });
+
+  test("option default does not leak to alias when one alias parsed", () => {
+    const cli = cac();
+    cli.option("-b, --base-url <url>", "Set base URL", {
+      default: "https://github.com",
+    });
+    const { options } = cli.parse(["node", "bin", "--base-url", "https://gitlab.com"]);
+    expect(options.baseUrl).toBe("https://gitlab.com");
+    expect(options.b).toBe("https://gitlab.com");
+  });
+
+  test("option default does not leak when short flag parsed", () => {
+    const cli = cac();
+    cli.option("-b, --base-url <url>", "Set base URL", {
+      default: "https://github.com",
+    });
+    const { options } = cli.parse(["node", "bin", "-b", "https://gitlab.com"]);
+    expect(options.baseUrl).toBe("https://gitlab.com");
+    expect(options.b).toBe("https://gitlab.com");
+  });
+
+  test("boolean flag with default works correctly with aliases", () => {
+    const cli = cac();
+    cli.option("-f, --force", "Force mode", { default: false });
+    const { options } = cli.parse(["node", "bin", "-f"]);
+    expect(options.force).toBe(true);
+    expect(options.f).toBe(true);
+  });
 });

