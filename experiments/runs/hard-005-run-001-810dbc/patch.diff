@@ -12,4 +12,44 @@ describe("path-to-regexp regression", () => {
     const tokens = parse("/*splat");
     expect(tokens).toBeDefined();
   });
+  test("param followed by astral ID_Continue in text token must be quoted", () => {
+    // \u{1D6FC} is an astral ID_Continue character (mathematical italic)
+    // When a param is followed by text starting with an astral ID_Continue character,
+    // stringify must quote the param name to prevent it from being absorbed on re-parse.
+    const data = new TokenData([
+      { type: "text", value: "/" },
+      { type: "param", name: "test" },
+      { type: "text", value: "\u{1D6FC}" },
+    ]);
+    const str = stringify(data);
+    // Must quote 'test' because next text starts with astral ID_Continue
+    expect(str).toBe('/:"test"\u{1D6FC}');
+    // Verify round-trip
+    const tokens2 = parse(str);
+    expect(stringify(tokens2)).toBe(str);
+  });
+  test("wildcard followed by astral ID_Continue in text token must be quoted", () => {
+    // Same for wildcard parameters
+    const data = new TokenData([
+      { type: "text", value: "/" },
+      { type: "wildcard", name: "test" },
+      { type: "text", value: "\u{1D6FC}" },
+    ]);
+    const str = stringify(data);
+    expect(str).toBe('/*"test"\u{1D6FC}');
+    const tokens2 = parse(str);
+    expect(stringify(tokens2)).toBe(str);
+  });
+  test("param followed by non-ID_Continue emoji stays unquoted", () => {
+    // \u{1F600} (😀) is NOT ID_Continue, so no quoting needed
+    const data = new TokenData([
+      { type: "text", value: "/" },
+      { type: "param", name: "test" },
+      { type: "text", value: "\u{1F600}" },
+    ]);
+    const str = stringify(data);
+    expect(str).toBe("/:test\u{1F600}");
+    const tokens2 = parse(str);
+    expect(stringify(tokens2)).toBe(str);
+  });
 });
