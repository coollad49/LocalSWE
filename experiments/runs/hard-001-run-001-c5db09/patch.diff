diff --git a/test-reverse.mjs b/test-reverse.mjs
new file mode 100644
index 0000000..958d4ff
--- /dev/null
+++ b/test-reverse.mjs
@@ -0,0 +1,37 @@
+import { produce, enableArrayMethods } from "./src/immer.ts";
+
+enableArrayMethods();
+
+// Test case: reverse then mutate
+console.log("Test 1: reverse then mutate element");
+const base1 = [{a: 1}, {a: 2}];
+const next1 = produce(base1, draft => {
+    draft.reverse();
+    draft[0].a = 3;
+});
+console.log("next1:", JSON.stringify(next1));
+console.log("base1:", JSON.stringify(base1));
+console.log("base1[1] should still be {a: 2}:", base1[1].a === 2 ? "PASS" : "FAIL (got " + base1[1].a + ")");
+
+// Test case: sort then mutate
+console.log("\nTest 2: sort then mutate element");
+const base2 = [{a: 3}, {a: 1}, {a: 2}];
+const next2 = produce(base2, draft => {
+    draft.sort((a, b) => a.a - b.a);
+    draft[0].a = 10;
+});
+console.log("next2:", JSON.stringify(next2));
+console.log("base2:", JSON.stringify(base2));
+console.log("base2[1] should still be {a: 1}:", base2[1].a === 1 ? "PASS" : "FAIL (got " + base2[1].a + ")");
+
+// Test case: reverse twice (should return to original order)
+console.log("\nTest 3: reverse twice then mutate");
+const base3 = [{a: 1}, {a: 2}];
+const next3 = produce(base3, draft => {
+    draft.reverse();
+    draft.reverse();
+    draft[0].a = 99;
+});
+console.log("next3:", JSON.stringify(next3));
+console.log("base3:", JSON.stringify(base3));
+console.log("base3[0] should still be {a: 1}:", base3[0].a === 1 ? "PASS" : "FAIL (got " + base3[0].a + ")");
