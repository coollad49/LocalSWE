diff --git a/tmp_test.js b/tmp_test.js
new file mode 100644
index 0000000..efc3f98
--- /dev/null
+++ b/tmp_test.js
@@ -0,0 +1,52 @@
+import { defu, createDefu } from "./src/defu.ts";
+
+// Test 1: defu({}, JSON.parse('{"__proto__":{"polluted":true}}'))
+{
+  // Clean up first
+  delete (Object.prototype as any).polluted;
+  const payload = JSON.parse('{"__proto__":{"polluted":true}}');
+  const result = defu({}, payload);
+  console.log("Test 1 - defu({}, payload):");
+  console.log("  Object.prototype.polluted:", (Object.prototype as any).polluted);
+  console.log("  result.polluted:", (result as any).polluted);
+  console.log("  Object.getPrototypeOf(result):", Object.getPrototypeOf(result));
+  console.log("  result:", result);
+  console.log("  Object.getOwnPropertyDescriptor(result, '__proto__'):", Object.getOwnPropertyDescriptor(result, "__proto__"));
+}
+
+// Test 2: defu(payload, {})
+{
+  delete (Object.prototype as any).polluted;
+  const payload = JSON.parse('{"__proto__":{"polluted":true}}');
+  const result = defu(payload, {});
+  console.log("\nTest 2 - defu(payload, {}):");
+  console.log("  Object.prototype.polluted:", (Object.prototype as any).polluted);
+  console.log("  result.polluted:", (result as any).polluted);
+  console.log("  Object.getPrototypeOf(result):", Object.getPrototypeOf(result));
+}
+
+// Test 3: defu(payload, payload)
+{
+  delete (Object.prototype as any).polluted;
+  const payload = JSON.parse('{"__proto__":{"polluted":true}}');
+  const result = defu(payload, payload);
+  console.log("\nTest 3 - defu(payload, payload):");
+  console.log("  Object.prototype.polluted:", (Object.prototype as any).polluted);
+  console.log("  result.polluted:", (result as any).polluted);
+  console.log("  Object.getPrototypeOf(result):", Object.getPrototypeOf(result));
+}
+
+// Test 4: nested
+{
+  delete (Object.prototype as any).polluted;
+  const payload = JSON.parse('{"a":{"__proto__":{"polluted":true}}}');
+  const result = defu({a:{x:1}}, payload);
+  console.log("\nTest 4 - defu({a:{x:1}}, payload):");
+  console.log("  Object.prototype.polluted:", (Object.prototype as any).polluted);
+  console.log("  result:", JSON.stringify(result));
+  console.log("  result.a.polluted:", (result.a as any).polluted);
+  console.log("  Object.getPrototypeOf(result.a):", Object.getPrototypeOf(result.a));
+}
+
+// Final check
+console.log("\nFinal: ({}).polluted =", ({} as any).polluted);
