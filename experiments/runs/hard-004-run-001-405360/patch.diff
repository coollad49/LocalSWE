+	test("aborting signal while queued rejects and removes the task from the queue", async () => {
+		const queue = new PQueue({ concurrency: 1 });
+
+		// First task holds the only concurrency slot until we let it finish.
+		let releaseFirst: () => void = () => {};
+		const firstDone = new Promise<void>(resolve => {
+			releaseFirst = resolve;
+		});
+		await queue.add(() => firstDone);
+
+		// Second task should be queued (concurrency limit is 1).
+		const controller = new AbortController();
+		const secondPromise = queue.add(
+			async () => {
+				throw new Error("Second task should never run");
+			},
+			{signal: controller.signal},
+		);
+
+		// Sanity-check: it really is queued and not running.
+		assert.equal(queue.size, 1, "second task should be queued");
+		assert.equal(queue.pending, 1, "first task should be running");
+
+		// Abort the signal while the task is still queued.
+		controller.abort(new Error("aborted while queued"));
+
+		// The promise should reject with the abort reason.
+		await assert.rejects(secondPromise, /aborted while queued/);
+
+		// The task should be removed from the queue.
+		assert.equal(queue.size, 0, "aborted task should be removed from the queue");
+
+		// Release the first task; no further tasks remain.
+		releaseFirst();
+		await queue.onIdle();
+		assert.equal(queue.size, 0);
+		assert.equal(queue.pending, 0);
+	});
+
