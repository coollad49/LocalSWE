+		let max = 0;
+		const task = async () => {
+			running++;
+			max = Math.max(max, running);
+			await new Promise(r => setTimeout(r, 10));
+			running--;
+		};
+		await Promise.all([queue.add(task), queue.add(task), queue.add(task)]);
+		assert.equal(max, 1);
+	});
