index 0000000..7c7935d
--- /dev/null
+++ b/tests/repro-reverse-sort.test.ts
@@ -0,0 +1,49 @@
+import { describe, test, expect } from "vitest";
+import { produce, enableArrayMethods } from "../src/immer";
+
+enableArrayMethods();
+
+describe("reverse/sort base mutation regression", () => {
+  test("reverse then mutate element should not mutate base", () => {
+    const base = [{ value: 1 }, { value: 2 }, { value: 3 }];
+    const next = produce(base, (draft) => {
+      draft.reverse();
+      draft[0].value = 99;
+    });
+    expect(base[0].value).toBe(1);
+    expect(base[1].value).toBe(2);
+    expect(base[2].value).toBe(3);
+    expect(next[0].value).toBe(99);
+    expect(next[1].value).toBe(2);
+    expect(next[2].value).toBe(1);
+  });
+
+  test("sort then mutate element should not mutate base", () => {
+    const base = [{ value: 3 }, { value: 1 }, { value: 2 }];
+    const next = produce(base, (draft) => {
+      draft.sort((a, b) => a.value - b.value);
+      draft[0].value = 99;
+    });
+    expect(base[0].value).toBe(3);
+    expect(base[1].value).toBe(1);
+    expect(base[2].value).toBe(2);
+    expect(next[0].value).toBe(99);
+    expect(next[1].value).toBe(2);
+    expect(next[2].value).toBe(3);
+  });
+
+  test("reverse then mutate multiple elements should not mutate base", () => {
+    const base = [{ value: 1 }, { value: 2 }, { value: 3 }];
+    const next = produce(base, (draft) => {
+      draft.reverse();
+      draft[0].value = 10;
+      draft[2].value = 30;
+    });
+    expect(base[0].value).toBe(1);
+    expect(base[1].value).toBe(2);
+    expect(base[2].value).toBe(3);
+    expect(next[0].value).toBe(10);
+    expect(next[1].value).toBe(2);
+    expect(next[2].value).toBe(30);
+  });
+});

