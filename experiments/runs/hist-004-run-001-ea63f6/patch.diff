     };
     expect(() => mri(["--unknown", "val"], { unknown })).toThrow();
   });
+
+  test("boolean defaults do not leak into positional args", () => {
+    // When a boolean default is provided and a boolean flag is supplied,
+    // the parser should not push a numeric value into the _ array
+    const res = mri(["--foo"], { boolean: ["foo"], default: { bar: true } });
+    expect(res._).toEqual([]);
+    expect(res.foo).toBe(true);
+    expect(res.bar).toBe(true);
+  });
 });
