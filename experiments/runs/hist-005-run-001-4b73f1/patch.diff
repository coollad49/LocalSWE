diff --git a/tests/mri.test.ts b/tests/mri.test.ts
index d0b1825..4e1a06b 100644
--- a/tests/mri.test.ts
+++ b/tests/mri.test.ts
@@ -49,4 +49,37 @@ describe("mri regression", () => {
     };
     expect(() => mri(["--unknown", "val"], { unknown })).toThrow();
   });
+
+  test("string default propagates to alias", () => {
+    const res = mri(["-a", "01"], {
+      alias: { a: ["arg"] },
+      default: { arg: "01" },
+    });
+    expect(res.a).toBe("01");
+    expect(res.arg).toBe("01");
+    expect(typeof res.a).toBe("string");
+    expect(typeof res.arg).toBe("string");
+  });
+
+  test("boolean default propagates to alias", () => {
+    const res = mri(["-a", "foo"], {
+      alias: { a: ["arg"] },
+      default: { arg: true },
+    });
+    expect(res.a).toBe(true);
+    expect(res.arg).toBe(true);
+    expect(typeof res.a).toBe("boolean");
+    expect(typeof res.arg).toBe("boolean");
+  });
+
+  test("string default propagates when parsed via long name", () => {
+    const res = mri(["--arg", "01"], {
+      alias: { a: ["arg"] },
+      default: { arg: "01" },
+    });
+    expect(res.arg).toBe("01");
+    expect(res.a).toBe("01");
+    expect(typeof res.arg).toBe("string");
+    expect(typeof res.a).toBe("string");
+  });
 });
