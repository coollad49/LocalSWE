     for (const cliOption of cliOptions) {
       if (!ignoreDefault && cliOption.config.default !== undefined) {
-        for (const name of cliOption.names) {
-          options[name] = cliOption.config.default
+        // Only apply default values when none of this option's aliases
+        // were actually parsed on the command line. Otherwise the default
+        // would leak into the unparsed alias names (e.g. `-b` keeping
+        // `https://github.com` while `--base-url https://gitlab.com` was
+        // parsed).
+        const hasParsedName = cliOption.names.some(
+          (name) => parsed[name] !== undefined
+        )
+        if (!hasParsedName) {
+          for (const name of cliOption.names) {
+            options[name] = cliOption.config.default
+          }
         }
       }
 
