+
+  test("stringify quotes param names followed by astral ID_Continue", () => {
+    // Construct tokens manually: a param 'a' followed by text starting with astral char
+    const data = new TokenData([
+      { type: "param", name: "a" },
+      { type: "text", value: "\u{10400}" },
+    ]);
+    const str = stringify(data);
+    // The name 'a' should be quoted because the next text starts with ID_Continue astral char
+    // Without quoting, parse will absorb the astral char into the param name
+    expect(str).toBe(':"a"\u{10400}');
+    // Round trip must work
+    const tokens2 = parse(str);
+    const str2 = stringify(tokens2);
+    expect(str2).toBe(str);
+  });
