{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "v2",
  "agentVersion": "agent-v2",
  "model": "opencode-go/mimo-v2.5",
  "maxTurns": 35,
  "maxIterations": 4,
  "timeoutMs": 600000,
  "maxExplorationTurns": 4,
  "enableInvariantSynthesis": true,
  "maxInvariantPermutations": 50,
  "enableRollbackOnRegression": true,
  "maxRollbacks": 3,
  "temperature": 0.1,
  "runsPerCase": 1
}
